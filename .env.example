# mobius: environment template. Copy to .env and fill in real values.
# .env is gitignored. NEVER commit real keys (repo files, README, notebooks,
# screenshots, logs). Placeholder values only in this file.
#
# Variable names follow the Participant Setup Guide (21 Oct 2026), the
# Meterless Runtime provider contract and the Zetaris client-setup docs.

# --- Meterless Nightshift: the primary AI provider (required) --------------
# From Nightshift > Console (top right): the Runtime URL and API key.
# These are Nightshift credentials, NOT the NVIDIA key (that one lives in
# Nightshift > Setup > Providers and never in this file).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Stable lowercase app id sent as the meterless-app header.
METERLESS_APP=mobius
# Routing mode used when a role has no pinned model. meterless/auto may pick a
# non-NVIDIA model, so pin each agent role to a Nemotron-backed route below.
METERLESS_MODEL=meterless/auto
# Per-role routes, taken from GET /v1/models once your lanes are set up.
# Planner and the escalation path use the deep lane, the Executor the fast
# lane, the Critic the judge lane, so the Critic never grades its own output.
MOBIUS_PLANNER_MODEL=
MOBIUS_EXECUTOR_MODEL=
MOBIUS_CRITIC_MODEL=

# --- Zetaris: the data layer (required) ------------------------------------
# Local install: http://localhost:8888/api/v1.0 and org id 1.
# Managed AWS cluster: the URLs on the cluster's Overview > Access panel, and
# the numeric id under Management > Organisation.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Management > API Tokens > +. Create it yourself; it is shown only once.
ZETARIS_API_KEY=your-zetaris-api-key
# Only needed to download the API spec (HTTP Basic auth).
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password
ZETARIS_BASE_URL=http://localhost:3000

# --- Zetaris workspace bucket (managed AWS cluster) -------------------------
# A managed Zetaris cluster cannot read this laptop, so `publish` uploads the
# scan tables as CSV to the cluster's WorkspaceS3Bucket (CloudFormation stack >
# Resources). Use an IAM user limited to that one bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
MOBIUS_S3_BUCKET=

# --- Meterless Engine: H-MEM (required: one engine, working, tested) -------
# Where the agent's cross-session memory lives. Defaults to .themob/hmem.
# MOBIUS_HMEM_DIR=

# --- NVIDIA ----------------------------------------------------------------
# Nothing to set here. The NVIDIA API key goes in Nightshift > Setup >
# Providers; mobius reaches Nemotron THROUGH Nightshift.

# --- Existing themob model providers (optional, local dev only) ------------
# The submission's primary provider is Nightshift.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# THEMOB_LLM_PROVIDER=meterless

# --- mobius knobs ----------------------------------------------------------
# true: replay a recorded live run with no live services or keys, so a judge
# can see it work. false: live; every sponsor service must be reachable.
SAMPLE_MODE=true
